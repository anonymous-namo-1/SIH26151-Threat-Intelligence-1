"""
ARGUS — Module: Profile Page Parser
------------------------------------------------------------------
Parses a PASTED block of text representing a profile page (synthetic
test data, or a public page an analyst has copied text from) and pulls
out structured fields.

This module does NOT:
    - log in to anything
    - bypass authentication
    - scrape live websites
    - fetch anything over the network

It only reads text you give it, the same way the other extractor
modules do. Feed it pasted synthetic profile text, or text an analyst
has manually copied from a page they were already authorized to view.

Usage:
    from profile_parser import parse_profile
    record = parse_profile(text, source_meta={...})
"""

import re
from datetime import datetime, timezone


# ---------------------------------------------------------------------
# STEP 1: Patterns for each field we want to pull out.
# Each is deliberately loose/simple — tune for your real sample data.
# ---------------------------------------------------------------------
FIELD_PATTERNS = {
    "username": r'(?:username|user)[:\s]+["\']?([A-Za-z0-9_\-]{3,32})["\']?',
    "alias": r'(?:alias|a\.?k\.?a\.?|known as)[:\s]+["\']?([A-Za-z0-9_\-]{3,32})["\']?',
    "joined_date": r'(?:joined|member since|registered)[:\s]+(\d{4}-\d{2}-\d{2}|\d{1,2}[/-]\d{1,2}[/-]\d{2,4})',
    "reputation": r'(?:reputation|rep|trust score)[:\s]+(\d+(?:\.\d+)?%?)',
    "sales_count": r'(?:sales|deals completed)[:\s]+(\d+)',
    "posts_count": r'(?:posts|post count)[:\s]+(\d+)',
    "last_active": r'(?:last active|last seen|last login)[:\s]+(\d{4}-\d{2}-\d{2}|\d{1,2}[/-]\d{1,2}[/-]\d{2,4})',
    "pgp": r'(?:PGP|GPG)[:\s]+([A-F0-9]{8,40})',
    "wallet": r'(?:BTC|ETH|wallet)[:\s]+(bc1[a-z0-9]{14,59}|0x[a-fA-F0-9]{40}|[13][a-km-zA-HJ-NP-Z1-9]{25,34})',
    "profile_url": r'(?:profile url|source|url)[:\s]+(https?://\S+)',
}

# Contact handles can appear multiple times (Telegram, Signal, etc.)
CONTACT_HANDLE_PATTERN = (
    r'(?:contact|telegram|signal|jabber)\s*:\s*'
    r'(?:(?:telegram|signal|jabber)\s*:\s*)?'
    r'["\']?([A-Za-z0-9_@\.\-]{3,40})["\']?'
)


def _now_iso():
    return datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')


# ---------------------------------------------------------------------
# STEP 2: The main parse function — run every pattern, collect results
# ---------------------------------------------------------------------
def parse_profile(text: str, source_meta: dict | None = None) -> dict:
    """
    Args:
        text: pasted profile page text (synthetic or authorized-public)
        source_meta: optional dict, e.g.
            {"platform": "LeakHub Market", "source_type": "synthetic_profile"}

    Returns:
        A structured profile record. Any field not found is None (or []
        for contact_handles), so you can see clearly what was and
        wasn't extracted.
    """
    source_meta = source_meta or {}
record = {
        "platform": source_meta.get("platform", "unknown"),
        "source_type": source_meta.get("source_type", "unknown"),
        "extracted_at": _now_iso(),
    }

    # Run each single-value field pattern
    for field, pattern in FIELD_PATTERNS.items():
        m = re.search(pattern, text, flags=re.IGNORECASE)
        record[field] = m.group(1) if m else None

    # Contact handles: can be more than one, so collect all matches
    contacts = re.findall(CONTACT_HANDLE_PATTERN, text, flags=re.IGNORECASE)
    record["contact_handles"] = sorted(set(contacts))

    return record


# ---------------------------------------------------------------------
# Self-test / demo — a fully SYNTHETIC example profile page
# ---------------------------------------------------------------------
if __name__ == "__main__":
    synthetic_profile_text = """
    === Vendor Profile ===
    Username: blackfalcon
    Alias: BlackFalcon_Ops
    Joined: 2025-03-14
    Reputation: 92%
    Sales: 118
    Posts: 340
    Last active: 2026-09-01
    Contact: @black_falcon_chat
    Contact: telegram: blackfalcon_market
    PGP: A1B2C3D4E5F60708
    BTC: bc1qfakewallet123abcxyz
    Profile URL: http://example-synthetic-market.test/vendor/blackfalcon
    """

    meta = {"platform": "LeakHub Market (synthetic)", "source_type": "synthetic_profile"}
    result = parse_profile(synthetic_profile_text, meta)

    print("=== Parsed Profile Record ===")
    for k, v in result.items():
        print(f"  {k}: {v}")

