FROM node:24-slim AS build
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /workspace

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.json tsconfig.base.json ./
COPY lib ./lib
COPY artifacts/api-server ./artifacts/api-server
RUN pnpm install --frozen-lockfile --filter @workspace/api-server...
RUN pnpm --filter @workspace/api-server run build

FROM node:24-slim
ENV NODE_ENV=production
WORKDIR /workspace
COPY --from=build /workspace /workspace
# The bundled route resolves its isolated parser relative to dist. Keep the
# source scripts directory in the image and place the parser at that location.
RUN mkdir -p artifacts/api-server/dist/scripts && \
    cp artifacts/api-server/scripts/parse-document.mjs artifacts/api-server/dist/scripts/parse-document.mjs
WORKDIR /workspace/artifacts/api-server
# Run only Express. run.mjs is the Replit composite launcher and would also
# start Python, which is a separate Compose service.
CMD ["node", "--enable-source-maps", "./dist/index.mjs"]
