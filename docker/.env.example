# Copy to docker/.env and replace every placeholder locally. Never commit it.
POSTGRES_DB=argus_development
POSTGRES_USER=argus_developer
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_LOCAL_SECRET

CLERK_PUBLISHABLE_KEY=REPLACE_WITH_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=REPLACE_WITH_CLERK_SECRET_KEY
CLERK_PROXY_URL=

ARGUS_ANALYSIS_WORKER=true
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=
LOG_LEVEL=info

# Replit-specific object paths; setting these externally is insufficient
# without the Replit credential/signing sidecar.
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=
