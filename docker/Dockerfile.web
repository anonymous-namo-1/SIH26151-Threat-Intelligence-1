FROM node:24-slim AS build
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /workspace

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.json tsconfig.base.json ./
COPY lib ./lib
COPY artifacts/sih26151-intelligence ./artifacts/sih26151-intelligence
RUN pnpm install --frozen-lockfile --filter @workspace/sih26151-intelligence...
RUN pnpm --filter @workspace/sih26151-intelligence run build

FROM node:24-slim
ENV NODE_ENV=production \
    PORT=3000
WORKDIR /workspace
COPY --from=build /workspace /workspace
WORKDIR /workspace/artifacts/sih26151-intelligence
CMD ["../../node_modules/.bin/pnpm", "run", "serve"]
